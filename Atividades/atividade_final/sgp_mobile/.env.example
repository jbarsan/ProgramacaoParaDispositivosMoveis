# Modelo de variáveis de ambiente para o SGP Mobile (CPPT/MPPI)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# ATENÇÃO: Nunca versione o arquivo .env no Git.

# Conta inicial de bootstrap do sistema
ADMIN_MASTER_EMAIL=administrador@sgp.com.br

# Google Maps API Key (Android e Web)
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Configurações Firebase (Android e Web)
FIREBASE_API_KEY_ANDROID=sua_chave_android_aqui
FIREBASE_API_KEY_WEB=sua_chave_web_aqui
FIREBASE_APP_ID_ANDROID=seu_app_id_android_aqui
FIREBASE_APP_ID_WEB=seu_app_id_web_aqui
FIREBASE_MESSAGING_SENDER_ID=seu_sender_id_aqui
FIREBASE_PROJECT_ID=seu_project_id_aqui
FIREBASE_STORAGE_BUCKET=seu_bucket_aqui
FIREBASE_AUTH_DOMAIN=seu_auth_domain_aqui
