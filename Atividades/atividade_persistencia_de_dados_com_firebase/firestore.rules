rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Modo de produção: permite leitura e escrita apenas para o usuário
    // autenticado nos seus próprios contatos (usuarios/{uid}/contatos/{contatoId})
    match /usuarios/{userId}/contatos/{contatoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueia qualquer outro acesso por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
